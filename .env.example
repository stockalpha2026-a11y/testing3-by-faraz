# Copy this file to .env and fill in your real values from:
# Supabase Dashboard → Project Settings → API

VITE_SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Chatbot (server-side only, NO VITE_ prefix). Get a key at openrouter.ai
OPENROUTER_API_KEY=

# Payments page (Renew): your UPI ID and the name shown to customers
VITE_PAY_UPI_ID=
VITE_PAY_NAME=
